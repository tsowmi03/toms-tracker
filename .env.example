# Copy this file to .env.local for development or .env.production.local for a live build.
# Firebase web configuration values are identifiers, not server secrets. Firestore rules
# isolate each signed-in user's data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Required for the multi-user production build.
VITE_ALLOW_SIGN_UP=true
