# Copy this file to .env.local for development or .env.production.local for a live build.
# Firebase web configuration values are identifiers, not server secrets. Firestore rules
# and the owner UID are the actual data-access boundary.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Required for a live build. Sign in once, copy the account UID from Firebase
# Authentication, and use the same UID in firestore.rules.
VITE_FIREBASE_OWNER_UID=

# Enable only while creating the initial email/password owner account.
VITE_ALLOW_SIGN_UP=false
