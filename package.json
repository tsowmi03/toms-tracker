{
  "name": "toms-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "node scripts/check-production-env.mjs && npm run build",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec --project demo-toms-tracker --only firestore \"vitest run tests/firestore.rules.test.ts\""
  },
  "dependencies": {
    "firebase": "12.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
